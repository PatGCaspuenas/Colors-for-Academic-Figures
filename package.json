{
  "name": "colors-for-academic-figures",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive color picker playground for academic figures",
  "scripts": {
    "build": "esbuild src/main.jsx --bundle --minify --format=iife --loader:.js=jsx --define:process.env.NODE_ENV=\\\"production\\\" --outfile=docs/app.js",
    "dev": "esbuild src/main.jsx --bundle --format=iife --loader:.js=jsx --define:process.env.NODE_ENV=\\\"development\\\" --outfile=docs/app.js --watch --servedir=docs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "react": "^17.0.2",
    "react-color": "^2.19.3",
    "react-dom": "^17.0.2",
    "tinycolor2": "^1.6.0"
  }
}
